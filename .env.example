# Public configuration (safe for browser and Expo client bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
EXPO_PUBLIC_AUTH_PREVIEW=false
EXPO_PUBLIC_RIDER_LOGIN_URL=

# Server-only configuration (never expose with NEXT_PUBLIC_ or EXPO_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_DB_PASSWORD=replace-with-local-or-development-db-password
