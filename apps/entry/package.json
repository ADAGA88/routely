{
  "name": "@routely/entry",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web --port 8080",
    "build": "expo export --platform web",
    "android": "expo start --android --port 8080",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('.expo',{recursive:true,force:true});require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@routely/auth": "workspace:*",
    "@routely/design-tokens": "workspace:*",
    "@routely/ui-mobile": "workspace:*",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "^5.8.3"
  }
}
