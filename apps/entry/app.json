{
  "expo": {
    "name": "Routely",
    "slug": "routely-entry",
    "scheme": "routely",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "platforms": ["ios", "android", "web"],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Routely to choose a photo of your parcel.",
          "cameraPermission": "Allow Routely to take a photo of your parcel.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
